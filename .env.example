# Modelo de configuracao do docker compose.
#
#   cp .env.example .env
#
# O arquivo .env NAO vai para o repositorio (esta no .gitignore). Para gerar os
# valores aleatorios:
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- banco (obrigatorio) ---------------------------------------------------
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_USER=rtc
POSTGRES_DB=correlacao_rtc

# --- sessoes (obrigatorio) -------------------------------------------------
# Sem uma chave fixa, todo reinicio desconecta quem estava logado.
RTC_SECRET_KEY=troque-por-uma-string-aleatoria-longa

# --- senhas dos usuarios de fabrica (opcional) -----------------------------
# Em branco, valem as senhas de desenvolvimento (admin/2026, Cliente/Cliente,
# Teste/123). Em qualquer maquina exposta a internet, preencha as tres.
RTC_SENHA_ADMIN=
RTC_SENHA_CLIENTE=
RTC_SENHA_TESTE=

# --- rede (opcional) -------------------------------------------------------
# Porta publicada no host.
PORTA=8000
# 1 somente se houver um proxy (Nginx, Traefik, Caddy) terminando o HTTPS.
RTC_ATRAS_DE_PROXY=0
